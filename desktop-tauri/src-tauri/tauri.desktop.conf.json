{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/inkism-engine"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.macos.plist"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "Korean",
          "English"
        ],
        "installerHooks": "../installer/windows/inkism-protocol.nsh"
      }
    }
  }
}
